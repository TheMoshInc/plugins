{
  "_comment": "patchCreatorLineRichMenu の完成形リクエスト。6分割(SIX_SPLIT)=エリア6件、ラベルA〜Fを位置順に並べる。action は url / postbackActions / richMenuSwitch の3キーが常に必須。_ で始まるキーは説明用で、実際の呼び出しには含めない（余分なキーは入力エラーになる）。",
  "pathParams": {
    "id": 1234
  },
  "bodyParams": {
    "name": "通常メニュー 2026年10月",
    "layout": "SIX_SPLIT",
    "backgroundMoshImageId": "01JXXXXXXXXXXXXXXXXXXXXXXX",
    "areas": [
      {
        "_position": "左上",
        "_pattern": "URL のみ",
        "label": "A",
        "action": {
          "url": "https://mosh.jp/classes/12345",
          "postbackActions": null,
          "richMenuSwitch": null
        }
      },
      {
        "_position": "中央上",
        "_pattern": "URL のみ",
        "label": "B",
        "action": {
          "url": "https://mosh.jp/classes/12345/reservations",
          "postbackActions": null,
          "richMenuSwitch": null
        }
      },
      {
        "_position": "右上",
        "_pattern": "postback のみ（テキスト返信）。Webhook が MOSH に向いていないと動かない",
        "label": "C",
        "action": {
          "url": null,
          "postbackActions": [
            {
              "postbackActionType": "sendMessage",
              "messages": [
                {
                  "messageType": "text",
                  "message": "お問い合わせありがとうございます。営業時間内に順次ご返信します。"
                }
              ]
            }
          ],
          "richMenuSwitch": null
        }
      },
      {
        "_position": "左下",
        "_pattern": "postback のみ（タグ付与）。contactTagId は getCreatorContactTags で確認した値だけを入れる（自分のタグでないと保存時に拒否される）",
        "label": "D",
        "action": {
          "url": null,
          "postbackActions": [
            {
              "postbackActionType": "addContactTag",
              "contactTagId": 87
            }
          ],
          "richMenuSwitch": null
        }
      },
      {
        "_position": "中央下",
        "_pattern": "URL + postback の併用。URL を開くときにタグの付け外しも走る（最大3件）。Webhook 不要",
        "label": "E",
        "action": {
          "url": "https://mosh.jp/classes/12345/tickets",
          "postbackActions": [
            {
              "postbackActionType": "addContactTag",
              "contactTagId": 88
            },
            {
              "postbackActionType": "removeContactTag",
              "contactTagId": 87
            }
          ],
          "richMenuSwitch": null
        }
      },
      {
        "_position": "右下",
        "_pattern": "別メニューへの切り替え。切り替え先は同じ LINE公式アカウントの実在するメニューID（一覧で確認した値）。設定すると url は使われない",
        "label": "F",
        "action": {
          "url": null,
          "postbackActions": null,
          "richMenuSwitch": {
            "richMenuId": 1180
          }
        }
      }
    ],
    "chatBarText": "メニュー",
    "chatBarOpenByDefault": true
  }
